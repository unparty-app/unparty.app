# =============================================================================
# theunpartyapp Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values. Every key goes in
# .env: the site and Prisma's CLI (npm run db:push, db:seed:setup) both read it.
# Git ignores every .env* file except this one. NEVER commit .env.
#
# Every key is optional. With none, your site runs and goes live: no sign-in,
# /admin and /party locked, database-backed sections empty. The placeholders
# below count as no key, so copying this file changes nothing until you fill one in.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (optional): thoughts, votes, steps, submissions, your admin data
# -----------------------------------------------------------------------------
# PostgreSQL on Neon (https://neon.com). The schema is Postgres-only, so SQLite
# will not work. Walkthrough: /article/setup-database
#
# In Neon: project dashboard -> Connect.
# Pooled connection (Connection pooling ON, host contains "-pooler"), used by the site:
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection (Connection pooling OFF, same host without "-pooler"), used by
# Prisma to create tables. If you add Neon through the Vercel Marketplace, it names
# this DATABASE_URL_UNPOOLED; copy its value into DIRECT_DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project.us-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# SIGN-IN (optional): opens /admin and /party. Walkthrough: /article/setup-sign-in
# -----------------------------------------------------------------------------
# Clerk authentication keys
# Get these from: https://dashboard.clerk.com
# 1. Create an account at clerk.com
# 2. Create a new application
# 3. Copy the API keys from the dashboard
#
# For development, use test keys (pk_test_... and sk_test_...)
# For production, use live keys (pk_live_... and sk_live_...)
#
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# Optional: other sites of yours that use this site's sign-in (Clerk satellite
# apps), comma-separated. Leave unset if you have none. Changing it needs a
# rebuild, since NEXT_PUBLIC_ values are built into the site
# NEXT_PUBLIC_CLERK_ALLOWED_REDIRECT_ORIGINS="https://app.yourname.com,http://localhost:3001"

# -----------------------------------------------------------------------------
# PAYMENTS (optional): sell your projects with Polar
# -----------------------------------------------------------------------------
# Walkthrough: /article/setup-payments
# Get these from: https://polar.sh/dashboard (test first at https://sandbox.polar.sh)
# Docs: https://polar.sh/docs/llms.txt
#
# A project sells from its own page once its entry in
# src/data/FoundersConfig.json ("projects") has a "polarProductId".
# Checkout is embedded and opens for signed-in visitors. For the embed to
# load, add your site's host(s) to Polar's embedding allowlist under
# Settings → Preferences → Embedding (e.g. "www.yourname.com localhost:3000").
#
# POLAR_SERVER picks which Polar the keys belong to: "sandbox" (test money)
# or "production" (real money). Left unset, it is "sandbox" for npm run dev
# and "production" for every deployed build, Vercel previews included. Set it
# on Vercel's Preview environment to keep previews on sandbox. Sandbox and
# production are separate accounts with separate keys and product IDs.
#
# POLAR_ACCESS_TOKEN="polar_at_your_access_token_here"
# POLAR_WEBHOOK_SECRET="polar_wh_your_webhook_secret_here"
# POLAR_SERVER="sandbox"

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------

# File uploads (optional): Vercel Blob
# Walkthrough: /article/setup-file-uploads
# Photo-upload steps and the admin /blobupload page store files here.
# In Vercel: your project → Storage → Create Storage → Blob. Choose **Public**
# access (the code uploads public files, and a store's access can't be
# changed later) and tick Development too, so your computer can use it.
# On Vercel the site signs in with OIDC and BLOB_STORE_ID, which Vercel adds
# itself. Locally, copy BLOB_READ_WRITE_TOKEN here (Vercel adds it when you
# create the store from the project); no token, run `vercel env pull` once.
# Neither set, photo prompts still open but say uploads are off.
# Uploads pass through a Vercel Function, so each file must be 4.5 MB or less.
#
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Apple Music integration (optional)
# Required for MusicKit playback features
# Get from: https://developer.apple.com/account/resources/authkeys/list
# 1. Create a MusicKit key in Apple Developer portal
# 2. Download the .p8 private key file
# 3. Get your Team ID from Membership details
# 4. Get the Key ID from the key details
# 
# IMPORTANT: Keep the \n newlines in APPLE_MUSIC_PRIVATE_KEY
# Example format:
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
#
# APPLE_MUSIC_TEAM_ID="XXXXXXXXXX"
# APPLE_MUSIC_KEY_ID="ABCD123456"
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# Search API (optional)
# Search always covers your own pages, articles, stories and steps. Set this to
# also search a knowledge base API you run (it answers POST /api/chat). Unset,
# no query leaves your site. See /article/setup-search
# SEARCH_API_URL="https://search.example.com"

# LLM connection (optional, src/lib/llm.ts, /article/setup-get-your-claude)
# Your site works without a model. With one, a reader's thought gets a short
# reply under it, and "where are you starting from?" understands their own
# words. Set one of these; the first one set is used.
#
# 1. Your Anthropic key: one account, straight to Anthropic. Cap spend with a
#    limit in the Anthropic Console
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-5-5"   # optional, Anthropic's model id
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."   # only for a key made outside a workspace
#
# 2. Vercel AI Gateway: any provider's models, fallbacks and Gateway budgets.
#    On a Vercel deployment the key is optional (it authenticates with OIDC).
#    Pick a model id from https://ai-gateway.vercel.sh/v1/models
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key"
# AI_GATEWAY_MODEL="provider/model"
#
# Readers can also bring their own Anthropic key, kept in their browser tab and
# sent straight to Anthropic (never billed to you). It uses ANTHROPIC_MODEL too.

# Email via Loops (optional)
# Walkthrough: /article/setup-email
# Loops only sends from your own verified domain (SPF, DKIM and MX records,
# not a *.vercel.app address), so set up your domain first.
# Get the key from: https://loops.so/settings/api
# Each email is a transactional template in YOUR Loops account. Create it,
# publish it, then copy its ID from the template's API Details. An email with
# no template ID set is simply not sent. Variable names are case-sensitive,
# and a template that uses a variable the site doesn't send fails to send.
#   LOOPS_IDEA_SUBMITTED_ID    worksheet received      (name, ideaName, deadline, isUpdate)
#   LOOPS_IDEA_UPDATED_ID      worksheet edited        (same variables)
#   LOOPS_WAITLIST_APPROVED_ID you let them in         (name, ideaName)
#   LOOPS_RELEASE_NOTICE_ID    a new release, to builds that left an email (name, version, notes, link); unparty.app only (#589)
#
# LOOPS_API_KEY="loops_your_api_key_here"
# LOOPS_IDEA_SUBMITTED_ID="your_template_id"
# LOOPS_IDEA_UPDATED_ID="your_template_id"
# LOOPS_WAITLIST_APPROVED_ID="your_template_id"
# LOOPS_RELEASE_NOTICE_ID="your_template_id"

# Slack (optional)
# Walkthrough: /article/setup-slack
# One Slack app (https://api.slack.com/apps → Create New App → From scratch),
# with Incoming Webhooks turned on and one webhook per channel:
#   SLACK_WEBHOOK_URL       each waitlist worksheet (/api/problem/send)
#   SLACK_WEBHOOK_URL_CHAT  each message sent through the site's chat box
#                           (/api/chat/send)
# Optional Approve / Reject buttons on worksheet messages: turn on
# Interactivity & Shortcuts, set its Request URL to
# https://<your site>/api/slack/interactions, and copy the app's Signing
# Secret (Basic Information → App Credentials). With it set, the buttons appear.
#
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
# SLACK_WEBHOOK_URL_CHAT="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
# SLACK_SIGNING_SECRET="your_signing_secret"

# Vercel Workflow SDK (optional - for future durable workflows)
# Already installed via package.json - no environment variables needed!
# Currently disabled in favor of Slack for stability
# To enable: Uncomment workflow code in src/app/api/problem/send/route.ts
# See: https://workflow-sdk.dev

# A Google Sheet as a database (optional, /article/setup-google-sheet): the sheet's
# published CSV link (File → Share → Publish to web → .csv). Reading needs nothing else.
# BOOKS_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/your-link/pub?gid=0&single=true&output=csv"

# Google Sheets integration (optional): writing to that sheet (add a book. on
# /article/setup-google-sheet), with a service account the sheet is shared with as an Editor
# GOOGLE_SHEETS_ID="your-google-sheet-id"
# GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# GA4 reporting (optional, src/lib/ga-queries.ts — theunpartyapp#664)
# Reuses GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY above; that service
# account must ALSO be added as a Viewer in GA4 Admin -> Property Access
# Management (a GCP credential alone is not enough).
# GA4_PROPERTY_ID is the numeric property ID (GA4 Admin -> Property Settings),
# NOT the "G-XXXXXXX" measurement ID used in the gtag snippet.
# Smoke test: npm run test:ga-queries
# GA4_PROPERTY_ID="123456789"

# Admin user ID from Clerk (optional)
# Used to identify the founder/admin user
# FOUNDER_USER_ID="user_xxxxxxxxxxxxx"

# GitHub App (optional)
# Walkthrough: /article/setup-github-app
# Your own GitHub App lets the site read the repositories you install it on
# (stars, languages, README previews, releases), shown on /founders. Create it
# under your account's or organization's Settings → Developer settings →
# GitHub Apps, install it, and copy its App ID, installation ID and private key.
# Keep the \n line breaks in the key on one line here; in Vercel you can paste
# the .pem file's contents as they are.
#
# GITHUB_APP_ID="123456"
# GITHUB_APP_INSTALLATION_ID="12345678"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"
#
# Where story edits, articles and snapshot PRs are committed. On Vercel it is
# the repository you deployed from; set this only to override the name
# STORIES_REPO_NAME="your-site-repo"

# Waitlist review in GitHub Discussions (optional)
# Walkthrough: /article/setup-waitlist
# You can approve people in /admin/submissions without any of this. With it,
# each worksheet also opens a Discussion in the "Pending" category of this
# repository, and moving it to "Approve" lets the person in. Needs the GitHub
# App above, Discussions turned on with both categories, and a repository
# webhook to https://<your site>/api/github/webhook for "Discussions" events,
# signed with GITHUB_WEBHOOK_SECRET.
#
# WAITLIST_REPO_OWNER="your-github-org"
# WAITLIST_REPO_NAME="your-waitlist-repo"
# GITHUB_WEBHOOK_SECRET="a-long-random-string"

# -----------------------------------------------------------------------------
# ANALYTICS AND TRACES (OPTIONAL) — see /article/setup-observability
# -----------------------------------------------------------------------------
# Vercel Drains copy your site's page views and traces into your own database,
# shown in /admin/observability. Drains need a Vercel Pro team.
#
# One secret for both drains (Web Analytics -> /api/analytics/vercel, Traces ->
# /api/drains/traces): paste the same value into each drain's Signature
# Verification Secret. In production, a drain with no secret set is refused.
# Generate: openssl rand -hex 32
#
# DRAIN_SECRET="your_drain_secret_here"
# Older names, still read if DRAIN_SECRET is unset:
# VERCEL_WEBHOOK_SECRET (analytics), VERCEL_TRACE_DRAIN_SECRET / VERCEL_TRACING_DRAIN_SECRET (traces)
#
# Google Analytics (optional): your own GA4 Measurement ID. Unset, GA never loads.
# It is built into the page, so redeploy after changing it.
#
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# CRON JOBS
# -----------------------------------------------------------------------------
# Secret token Vercel Cron uses to authenticate scheduled job requests.
# Generate: openssl rand -base64 32
# Set the same value in Vercel project environment variables.
# Cron jobs: /api/cron/db-cleanup (daily 2am UTC — deletes observability rows > 30 days)
#
CRON_SECRET="your_cron_secret_here"

# -----------------------------------------------------------------------------
# BUILD CONFIGURATION (usually not needed)
# -----------------------------------------------------------------------------
# These are typically set automatically by the platform

# Vercel-specific (auto-set on Vercel)
# VERCEL="1"
# VERCEL_URL="your-project.vercel.app"

# Node environment (auto-set based on build context)
# NODE_ENV="development"
