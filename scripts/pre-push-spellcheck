#!/bin/sh
#
# Pre-push hook for theunpartyapp
#
# Runs the spelling + grammar check over the prose you are about to push, so
# typos get caught before a reader (or a PR comment) finds them.
#
# Non-blocking by design: it prints what it found and lets the push through.
# The point of issue #553 was catching typos "without too much overhead" —
# a hook that refuses to push a draft is exactly that overhead.
#
# To skip it entirely: git push --no-verify
#

# Colors for output
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Nothing to do if dependencies aren't installed yet.
[ -x node_modules/.bin/cspell ] || exit 0

# git feeds pre-push "<local ref> <local sha> <remote ref> <remote sha>" per ref.
# The remote sha is what the branch looks like on the remote right now, which is
# the right thing to diff against — it scopes the check to the commits actually
# being pushed. It's all zeros when the branch is new there, in which case fall
# back to main.
ZERO='0000000000000000000000000000000000000000'
BASE=''

while read -r _local_ref _local_sha _remote_ref remote_sha; do
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO" ]; then
    BASE="$remote_sha"
    break
  fi
done

if [ -z "$BASE" ]; then
  BASE='origin/main'
fi

echo "${YELLOW}🔍 Spellchecking the prose you're pushing...${NC}"
./spellcheck --base "$BASE" || true

exit 0
