#!/bin/sh
#
# Pre-commit hook for theunpartyapp
#
# 1. Blocks commits that stage oversized cover images in public/covers/
# 2. Stamps dates on staged stories, unppp articles, JSON and TS articles
#    (scripts/stamp-dates.js): the created date if missing, and the updated
#    date when the title or body changed. The date ships inside the commit.
#    A workflow used to stamp stories after merge, but its push to protected
#    main was rejected.
# 3. Auto-generates YAML frontmatter for newly added markdown files
#    in src/app/theunparty* directories before committing.
#
# Installed by scripts/install-git-hooks.sh as a wrapper that runs this file,
# so edits here apply without reinstalling.
#
# To skip this hook: git commit --no-verify
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Every check below runs a Node script. Git apps that start hooks without your
# shell's PATH may not find Node: skip with a note instead of blocking.
if ! command -v node >/dev/null 2>&1; then
  echo "${YELLOW}⊘ Node not found, skipping the pre-commit checks${NC}"
  exit 0
fi

# --- Cover image size check (blocking) ---------------------------------------

STAGED_COVER_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^public/covers/' || true)

if [ -n "$STAGED_COVER_FILES" ]; then
  echo "${YELLOW}🔍 Checking staged cover images for size...${NC}"
  if ! node scripts/check-cover-sizes.js --staged; then
    echo "${RED}✗ Commit blocked: oversized cover image(s) staged in public/covers/${NC}"
    echo "${YELLOW}Resize them first, or skip with: git commit --no-verify${NC}"
    exit 1
  fi
fi

# --- Dates (non-blocking) ---------------------------------------------------

STAGED_CONTENT=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(public/covers/stories/story-[0-9]+\.md|src/app/theunparty[^/]*/[^/]+\.md|content/articles/[^/]+\.json|src/app/constants/editorial-articles/articles/[^/]+\.ts)$' || true)

for file in $STAGED_CONTENT; do
  # Re-staging a file that also has unstaged edits would commit those edits
  # too, so leave it alone and say so.
  if ! git diff --quiet -- "$file"; then
    echo "${YELLOW}⊘ Not stamping $file: it has unstaged changes${NC}"
    continue
  fi
  STAMP_OUT=$(node scripts/stamp-dates.js "$file" 2>/dev/null | grep '^✓' || true)
  if [ -n "$STAMP_OUT" ]; then
    git add "$file"
    echo "${GREEN}${STAMP_OUT}${NC}"
  fi
done

# --- Frontmatter auto-generation (non-blocking) -------------------------------

echo "${YELLOW}🔍 Checking for new markdown files in UNPPP directories...${NC}"

# Get list of newly added markdown files in theunparty* directories
ADDED_MD_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '^src/app/theunparty.*/.*\.md$' || true)

if [ -z "$ADDED_MD_FILES" ]; then
  echo "${GREEN}✓ No new UNPPP markdown files to process${NC}"
  exit 0
fi

# Process each file
FILES_PROCESSED=0
FILES_SKIPPED=0

for file in $ADDED_MD_FILES; do
  # Check if file exists (might have been renamed or deleted)
  if [ ! -f "$file" ]; then
    continue
  fi
  
  # Check if file already has frontmatter
  if head -1 "$file" | grep -q "^---$"; then
    echo "${GREEN}⊘ Skipped $file (already has frontmatter)${NC}"
    FILES_SKIPPED=$((FILES_SKIPPED + 1))
    continue
  fi
  
  # Generate frontmatter
  echo "${YELLOW}📝 Generating frontmatter for $file...${NC}"
  
  if node scripts/generate-frontmatter.js "$file"; then
    # Stage the modified file
    git add "$file"
    echo "${GREEN}✓ Generated frontmatter for $file${NC}"
    FILES_PROCESSED=$((FILES_PROCESSED + 1))
  else
    echo "${RED}✗ Failed to generate frontmatter for $file${NC}"
    echo "${YELLOW}Commit will proceed, but you may want to add frontmatter manually.${NC}"
  fi
done

# Summary
echo ""
echo "────────────────────────────────────────────────────────────"
if [ $FILES_PROCESSED -gt 0 ]; then
  echo "${GREEN}✓ Auto-generated frontmatter for $FILES_PROCESSED file(s)${NC}"
fi
if [ $FILES_SKIPPED -gt 0 ]; then
  echo "${YELLOW}⊘ Skipped $FILES_SKIPPED file(s) with existing frontmatter${NC}"
fi
echo "────────────────────────────────────────────────────────────"

exit 0
