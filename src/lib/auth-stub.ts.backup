  return null
}
UserButtonComponent.displayName = 'UserButton'

const UserProfileLink = function(_props?: {
  label?: string
  url?: string
  labelIcon?: React.ReactNode
  [key: string]: unknown
}) {
  return null
}
UserProfileLink.displayName = 'UserProfileLink'
UserButtonComponent.UserProfileLink = UserProfileLink

// These stubs return simple divs
export const SignIn = () => null
export const SignUp = () => null
export const UserButton = UserButtonComponent
export const OrganizationSwitcher = (_props?: {
  appearance?: unknown
  [key: string]: unknown
}) => null
export const SignedIn = ({ children }: { children?: React.ReactNode }) => null
export const SignedOut = ({ children }: { children?: React.ReactNode }) => children

