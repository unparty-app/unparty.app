  "revenue_projections": {
    "baseline": {
      "label": "Baseline (Conservative)",
      "multiplier": 1.0,
      "note": "Based on comparable micro-budget thrillers 2021–2024 with limited theatrical, genre VOD strength"
    },
    "upside": {
      "label": "Upside (Festival Breakout)",
      "multiplier": 2.8,
      "note": "Assumes a major festival premiere (Sundance, SXSW) driving acquisition buzz and broader release"
    },
    "downside": {
      "label": "Downside (Minimal Traction)",
      "multiplier": 0.45,
      "note": "Assumes poor festival response, no acquisition, minimal VOD performance"
    },

    "channels": {
      "theatrical_domestic": {
        "label": "Theatrical (Domestic)",
