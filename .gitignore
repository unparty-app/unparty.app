# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Generated files follow one rule: track a generated file only when it can't
# be regenerated. Ignore it when every command that needs it (npm run build,
# npm run dev, CI) makes it first. Track it when some machines can't make it
# (Swift, ffprobe, analysis of your own repos) or when code imports it and
# nothing makes it before `npm run dev`. CLAUDE.md lists which is which.
#
# A line here only stops git from picking up a NEW file. A file git already
# tracks keeps being committed until you also run `git rm --cached <file>`.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env files: secrets stay on your computer (.env.example is the template)
.env*
!.env.example

# vercel
.vercel

# clerk configuration (can include secrets)
/.clerk/

# Prisma client output
/src/generated/prisma

# scratch space (cloned repos for previews, temporary files)
tmp/

# Analysis scripts with hardcoded tokens
analysis/git-python-count

# build results for CI/debugging (should not be committed)
build-results/

# Test files
test-*.js
test-*.png

# Generated files the build and dev regenerate (the rule above)
src/data/iconManifest.json
src/data/imageManifest.json
src/data/normalizedPageMedia.json
src/data/unpartyRefsManifest.json
src/data/routeManifest.json
public/data/story-repo-mappings.json
public/releases.json
public/releases/
src/data/focus.json

# dynamically generated status reports
unparty-status.md
unparty-status.json

# Rewritten by every `npm run audit:imports` run - local/CI output, not tracked source
unused-imports-audit.json
unused-imports-audit.md

# Personal CV, resume and job-search notes: kept on this machine, never in a
# copy or the public snapshot (#1310)
/resume/
