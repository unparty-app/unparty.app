{
  "name": "theunpartyapp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "npm run generate-unparty-refs && npm run generate-route-manifest",
    "build:banner": "node scripts/print-build-banner.js",
    "build": "npm run build:banner && npm run generate-unparty-refs && npm run generate-releases && npm run generate-focus && npm run extract-colors-optional && npm run generate-video-metadata-optional && npm run generate-cover-extensions && npm run generate-article-covers && npm run generate-placeholder-stories && npm run sync-stories && npm run analyze-story-repo-mentions && npm run generate-icons && npm run generate-images && npm run normalize-data && npm run generate-route-manifest && prisma generate && next build",
    "build:validate": "npm run build:banner && npm run generate-unparty-refs && npm run generate-releases && npm run extract-colors-optional && npm run generate-video-metadata-optional && npm run generate-cover-extensions && npm run generate-article-covers && npm run generate-placeholder-stories && npm run sync-stories && npm run analyze-story-repo-mentions && npm run generate-icons && npm run generate-images && npm run normalize-data && npm run generate-route-manifest && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "get-svgs": "node scripts/getSvgFilenames.js",
    "get-stories": "node scripts/generate-stories-manifest.js",
    "extract-colors": "swift scripts/precompute-colors.swift",
    "extract-colors-optional": "command -v swift >/dev/null 2>&1 && npm run extract-colors || echo 'Swift not available, using pre-generated colors'",
    "generate-video-metadata": "node scripts/generate-video-metadata.js",
    "generate-video-metadata-optional": "command -v ffprobe >/dev/null 2>&1 && npm run generate-video-metadata || echo 'ffprobe not available, using pre-generated video metadata'",
    "generate-cover-extensions": "node scripts/generate-cover-extensions.js",
    "generate-article-covers": "node scripts/generate-article-covers-manifest.js",
    "generate-placeholder-stories": "node scripts/generate-placeholder-stories.js",
    "sync-stories": "node scripts/sync-story-metadata.js",
    "analyze-story-repo-mentions": "node scripts/analyze-story-repo-mentions.js",
    "generate-word-frequency": "node scripts/generate-word-frequency.js",
    "generate-icons": "node scripts/generate-icon-manifest.js",
    "generate-images": "node scripts/generate-image-manifest.js",
    "generate-unparty-refs": "node scripts/generate-unparty-refs.js",
    "generate-route-manifest": "tsx scripts/generate-route-manifest.cts",
    "generate-runway-features": "node scripts/generate-runway-features.js",
    "generate-releases": "node scripts/generate-releases.mjs",
    "generate-focus": "node scripts/generate-focus.mjs",
    "normalize-data": "node scripts/normalize-page-data.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:setup": "tsx prisma/seed-setup.ts",
    "db:seed:make": "tsx prisma/seed-make.ts",
    "create:component-article": "node scripts/create-component-article.mjs",
    "db:snapshot": "tsx scripts/snapshot-db.ts",
    "test:user-progress": "tsx scripts/test-user-progress.ts",
    "test:ga-queries": "tsx scripts/test-ga-queries.ts",
    "test:vercel-queries": "tsx scripts/test-vercel-queries.ts",
    "test:baseline-snapshots": "tsx scripts/test-baseline-snapshots.ts",
    "migrate-books": "tsx scripts/migrate-books.ts",
    "postinstall": "prisma generate",
    "analyze-components": "node scripts/generate-component-health.js",
    "component-health": "node scripts/report-component-health.js",
    "debt-score": "node scripts/debt-score.js",
    "audit:imports": "node scripts/unused-imports-audit.js",
    "audit:covers": "node scripts/check-cover-sizes.js",
    "audit:component-homes": "node scripts/audit-component-homes.mjs",
    "spellcheck": "./spellcheck",
    "spellcheck:all": "./spellcheck --all",
    "spellcheck:fix": "./spellcheck --fix",
    "check:identity": "node scripts/check-founders-config.mjs",
    "validate:unppp-repos": "tsx scripts/validate-unppp-repo-mappings.ts",
    "priority:debug": "tsx scripts/priority-count-debug.ts",
    "generate-unppp-pageviews": "tsx scripts/generate-unppp-pageviews.ts",
    "backfill-dates": "node scripts/stamp-dates.js --all",
    "frontmatter:generate": "node scripts/generate-frontmatter.js",
    "frontmatter:check": "node scripts/generate-frontmatter.js --all --check",
    "frontmatter:validate": "tsx scripts/validate-md-frontmatter.ts --all",
    "frontmatter:install-hooks": "sh scripts/install-git-hooks.sh",
    "test:workflow": "bash test-workflow-integration.sh dev",
    "test:workflow:prod": "bash test-workflow-integration.sh prod",
    "validate:og": "tsx scripts/validate-og-tags.ts",
    "validate:og:local": "npm run build && npm run validate:og",
    "effort": "node scripts/sprint-effort-analysis.js",
    "effort:weekly": "node scripts/sprint-effort-analysis.js --days 7",
    "effort:sprint": "node scripts/sprint-effort-analysis.js --days 14",
    "effort:month": "node scripts/sprint-effort-analysis.js --days 30",
    "effort:json": "node scripts/sprint-effort-analysis.js --json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@clerk/nextjs": "^7.0.6",
    "@clerk/themes": "^2.4.57",
    "@headlessui/react": "^2.2.7",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.3.3",
    "@next/third-parties": "^16.2.12",
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@polar-sh/checkout": "^0.4.1",
    "@polar-sh/nextjs": "^0.9.5",
    "@polar-sh/sdk": "^1.0.2",
    "@prisma/client": "^6.14.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.92",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/mdx": "^2.0.14",
    "@types/ws": "^8.5.13",
    "@vercel/analytics": "^1.3.2",
    "@vercel/blob": "^2.8.2",
    "@vercel/otel": "^2.1.1",
    "@vercel/speed-insights": "^1.0.14",
    "ai": "^7.0.138",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "express": "^4.21.1",
    "framer-motion": "^12.9.2",
    "googleapis": "^149.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.7",
    "postcss": "^8.5.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "simple-git": "^3.36.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.182.0",
    "workflow": "^4.8.9",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.1",
    "cspell": "9.6.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "prisma": "^6.14.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
