#!/bin/bash

set -e

ARTICLES_DIR="src/app/constants/editorial-articles/articles"
INDEX_FILE="src/app/constants/editorial-articles/index.ts"
REGISTRY_FILE="src/app/constants/editorial-articles/registry.ts"
REGISTRY_ANCHOR="  // Add more converted articles here"

if [ ! -f "package.json" ]; then
  echo "Error: run this script from the project root."
  exit 1
fi

# Escape double quotes and backslashes for TypeScript string values
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

echo ""
echo "CREATE EDITORIAL ARTICLE"
echo "========================"
echo ""

# ── Required fields ──────────────────────────────────────────

read -p "Slug (kebab-case, e.g. my-new-article): " slug
[ -z "$slug" ] && echo "Error: slug is required." && exit 1

suggested_const=$(echo "$slug" | tr '[:lower:]-' '[:upper:]_')
read -p "Export const name [$suggested_const]: " constname
constname="${constname:-$suggested_const}"

read -p "Title: " title
[ -z "$title" ] && echo "Error: title is required." && exit 1

read -p "Description: " description
[ -z "$description" ] && echo "Error: description is required." && exit 1

read -p "Category (emoji recommended, e.g. 🎒): " category
[ -z "$category" ] && echo "Error: category is required." && exit 1

today=$(date +%Y-%m-%d)
read -p "Date [$today]: " date_input
date_input="${date_input:-$today}"

read -p "Published? (y/N): " pub_input
published="false"
[[ "$pub_input" =~ ^[Yy]$ ]] && published="true"

read -p "Author: " author
[ -z "$author" ] && echo "Error: author is required." && exit 1

# ── Optional fields ──────────────────────────────────────────

echo ""
echo "Optional fields (press Enter to skip):"
read -p "  Subtitle: " subtitle
read -p "  Read time (e.g. 5 min read): " readtime
read -p "  Challenge text: " challenge
read -p "  Author page (e.g. /founders): " authorpage
read -p "  Author image filename: " authorimage
read -p "  Tags (comma-separated, e.g. goal,core,start): " tags_input
read -p "  Music track ID (e.g. badbunny-dtmf): " musictrackid

# Build tags TypeScript array
tags_ts=""
if [ -n "$tags_input" ]; then
  tags_ts="["
  IFS=',' read -ra tag_arr <<< "$tags_input"
  for tag in "${tag_arr[@]}"; do
    tag=$(echo "$tag" | xargs)
    tags_ts="${tags_ts}\"${tag}\", "
  done
  tags_ts="${tags_ts%, }]"
fi

# ── Check destination doesn't already exist ───────────────────

filepath="${ARTICLES_DIR}/${slug}.ts"
if [ -f "$filepath" ]; then
  echo ""
  echo "Error: $filepath already exists."
  exit 1
fi

# The export name must be new too, or registering it would clash
if grep -qw "$constname" "$REGISTRY_FILE"; then
  echo ""
  echo "Error: $constname is already used in $REGISTRY_FILE. Pick another export name."
  exit 1
fi

# ── Write article file ────────────────────────────────────────
# Use printf for the dynamic frontmatter (avoids heredoc trailing-newline issues),
# then append the static scaffold via a single-quoted heredoc.

{
  printf "import type { EditorialArticle } from '../types';\n"
  printf "\n"
  printf "export const %s: EditorialArticle = {\n" "${constname}"
  printf "  slug: \"%s\",\n"        "$(esc "$slug")"
  printf "  title: \"%s\",\n"       "$(esc "$title")"
  [ -n "$subtitle" ]     && printf "  subtitle: \"%s\",\n"     "$(esc "$subtitle")"
  [ -n "$readtime" ]     && printf "  readTime: \"%s\",\n"     "$(esc "$readtime")"
  [ -n "$challenge" ]    && printf "  challenge: \"%s\",\n"    "$(esc "$challenge")"
  [ -n "$authorpage" ]   && printf "  authorPage: \"%s\",\n"   "$(esc "$authorpage")"
  [ -n "$authorimage" ]  && printf "  authorImage: \"%s\",\n"  "$(esc "$authorimage")"
  [ -n "$musictrackid" ] && printf "  musicTrackId: \"%s\",\n" "$(esc "$musictrackid")"
  [ -n "$tags_ts" ]      && printf "  tags: %s,\n"             "$tags_ts"
  printf "  description: \"%s\",\n" "$(esc "$description")"
  printf "  category: \"%s\",\n"    "$(esc "$category")"
  printf "  date: \"%s\",\n"        "${date_input}"
  printf "  published: %s,\n"       "${published}"
  printf "  author: \"%s\",\n"      "$(esc "$author")"
  printf "  sections: [\n"
} > "$filepath"

cat >> "$filepath" << 'SCAFFOLD'
    // HERO — large headline
    {
      id: 'hero',
      type: 'hero',
      content: 'YOUR HEADLINE HERE.',
      metadata: { size: 'large', emphasis: true }
    },

    // --- Uncomment sections as needed ---

    // PARAGRAPH — body text (size: 'small'|'medium'|'large', style: 'minimal'|'accent'|'highlight')
    // { id: 'intro', type: 'paragraph', content: '...', metadata: { dropCap: true, size: 'medium' } },

    // HEADING
    // { id: 'heading-1', type: 'heading', content: '...', metadata: { size: 'large' } },

    // QUOTE — or set metadata.bookId to pull from a Book DB record
    // { id: 'quote-1', type: 'quote', content: '...', metadata: { author: '...', style: 'highlight' } },

    // IMAGE — path relative to /public
    // { id: 'img-1', type: 'image', content: '/path/to/image.png', metadata: { alt: '...', caption: '...', align: 'center' } },

    // LIST — pipe-separated items (numbered: true for <ol>)
    // { id: 'list-1', type: 'list', content: 'Item one|Item two|Item three', metadata: { numbered: false } },

    // CODE
    // { id: 'code-1', type: 'code', content: '// your code here', metadata: { language: 'typescript' } },

    // CHALLENGE — 3-step interactive challenge (pollEnabled: true to allow voting)
    // { id: 'challenge-1', type: 'challenge', userPrompt: 'DO THE THING.', pollEnabled: false,
    //   stepOne: { emoji: '1️⃣', action: 'Step one.', description: '...' },
    //   stepTwo: { emoji: '2️⃣', action: 'Step two.', description: '...' },
    //   stepThree: { emoji: '3️⃣', action: 'Step three.', description: '...' },
    //   successMetric: '...' },

    // SCROLL ROW — horizontal scroll (scrollRowType: 'covers'|'stories'|'music'|'gif')
    // { id: 'row-1', type: 'scrollRow', metadata: { scrollRowType: 'covers', title: '...', coverIds: [], maxItems: 5, moreLink: '/covers' } },

    // MUSIC
    // { id: 'music-1', type: 'music', content: '...', metadata: { title: '...', musicTrackId: 'badbunny-dtmf' } },

    // VIDEO
    // { id: 'video-1', type: 'video', content: '/path/to/video.mp4', metadata: { controls: true, aspectRatio: '16:9', poster: '/path/to/thumb.jpg' } },

    // GIF
    // { id: 'gif-1', type: 'gif', content: '/path/to/anim.gif', metadata: { alt: '...', aspectRatio: '16:9', size: 'large', align: 'center' } },

    // TABLE
    // { id: 'table-1', type: 'table', metadata: { headers: ['Col A', 'Col B'], rows: [['val', 'val']] } },

    // RANKING — interactive ranking question (references admin Question system)
    // { id: 'ranking-1', type: 'ranking', questionId: 'brand_q1234567890', categoryId: 'brand' },

    // COMPONENT — embed a named React component
    // { id: 'component-1', type: 'component', metadata: { componentName: 'StoryPreview', componentProps: { coverId: 'cover-001' } } },

    // BADGE
    // { id: 'badge-1', type: 'badge', metadata: { badgeText: 'LABEL.', badgeVariant: 'primary', badgeSize: 'md', badgeLink: '/destination' } },

    // PERSONAL — small personal/meta note
    // { id: 'personal-1', type: 'personal', content: '...' },

    // STRIKE BLOCK
    // { id: 'strike-1', type: 'strikeBlock', content: 'STRUCK THROUGH TEXT.', metadata: { variant: 'standard' } },

    // COLUMNS — two-column layout (layout: '1:1'|'2:1'|'1:2', optional sticky: 'left'|'right')
    // { id: 'cols-1', type: 'columns', metadata: { layout: '1:1' },
    //   leftSections: [{ id: 'l1', type: 'paragraph', content: '...' }],
    //   rightSections: [{ id: 'r1', type: 'image', content: '/img.png', metadata: { alt: '...' } }] },

    // DIVIDER
    // { id: 'divider-1', type: 'divider' },

    // SECTION BREAK
    // { id: 'break-1', type: 'sectionBreak' },
  ]
};
SCAFFOLD

# ── Update index.ts ───────────────────────────────────────────

echo "export * from './articles/${slug}';" >> "$INDEX_FILE"

# ── Register in registry.ts ───────────────────────────────────
# getEditorialArticle only serves TS articles listed in EDITORIAL_ARTICLES, so an
# unregistered article 404s. Insert the import after the last './articles/' import
# and the entry above the anchor comment. awk + temp file instead of sed -i, which
# differs between macOS and GNU (Git Bash on Windows).

registered="false"
if grep -qF "$REGISTRY_ANCHOR" "$REGISTRY_FILE"; then
  tmpfile="${REGISTRY_FILE}.tmp"
  awk -v imp="import { ${constname} } from './articles/${slug}';" \
      -v entry="  ${constname}," \
      -v anchor="$REGISTRY_ANCHOR" '
    { lines[NR] = $0 }
    /^import .* from .\.\/articles\// { lastimp = NR }
    END {
      for (i = 1; i <= NR; i++) {
        if (lines[i] == anchor) print entry
        print lines[i]
        if (i == lastimp) print imp
      }
    }
  ' "$REGISTRY_FILE" > "$tmpfile" && mv "$tmpfile" "$REGISTRY_FILE"
  registered="true"
fi

# ── Done ──────────────────────────────────────────────────────

echo ""
echo "Created:    ${filepath}"
echo "Updated:    ${INDEX_FILE}"
if [ "$registered" = "true" ]; then
  echo "Registered: ${constname} in ${REGISTRY_FILE}"
fi
echo ""
echo "Next steps:"
echo "  1. Edit ${filepath} to fill in your sections"
if [ "$registered" = "true" ]; then
  echo "  2. Check your work: npx tsc --noEmit (no output means it is fine)"
else
  echo "  2. Could not find \"${REGISTRY_ANCHOR# }\" in ${REGISTRY_FILE}."
  echo "     Register it yourself: import ${constname} there and add it to EDITORIAL_ARTICLES"
  echo "  3. Check your work: npx tsc --noEmit (no output means it is fine)"
fi
echo ""
